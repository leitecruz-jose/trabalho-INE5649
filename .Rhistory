library(readxl)
# Importar o arquivo Excel
dados <- read_excel("dados_sao_paulo.xlsx")
# Visualizar os dados
View(dados)
library(zoo)
# Converter os meses para números
meses <- c("jan", "fev", "mar", "abr", "mai", "jun",
"jul", "ago", "set", "out", "nov", "dez")
mes <- match(substr(dados$Data, 1, 3), meses)
# Extrair e corrigir o ano
ano <- as.integer(sub(".*/", "", dados$Data))
ano <- ifelse(ano <= 26, 2000 + ano, 1900 + ano)
# Converter para ano e mês
dados$Data <- as.yearmon(
sprintf("%04d-%02d", ano, mes),
format = "%Y-%m"
)
head(format(dados$Data, "%m/%Y"))
class(dados$Data)
head(format(dados$Data, "%m/%Y"))
class(dados$Data)
# Selecionar a variável de interesse
variavel <- "Temperatura"
base <- dados[, c("Data", variavel)]
names(base)[2] <- "Valor"
# Ordenar cronologicamente
base <- base[order(base$Data), ]
# Verificar se existem meses duplicados
anyDuplicated(base$Data)
# Criar calendário mensal completo
calendario <- data.frame(
Data = seq(min(base$Data), max(base$Data), by = 1/12)
)
# Incluir meses que estejam faltando
base <- merge(calendario, base, by = "Data", all.x = TRUE)
# Identificar o primeiro ano e mês
inicio <- c(
as.integer(format(min(base$Data), "%Y")),
as.integer(format(min(base$Data), "%m"))
)
# Criar série temporal
serie <- ts(
base$Valor,
start = inicio,
frequency = 12
)
View(calendario)
View(dados)
plot(serie)
serie_tratada <- na.interp(serie)
library(forecast)
serie_tratada <- na.interp(serie)
decomposicao <- stl(
serie_tratada,
s.window = "periodic",
robust = TRUE
)
plot(decomposicao)
# Ajustar modelo
modelo <- ets(serie_tratada)
# Ver modelo selecionado
summary(modelo)
# Prever os próximos 12 meses
previsao <- forecast(modelo, h = 12)
# Visualizar previsão
plot(previsao)
plot(decomposicao)
