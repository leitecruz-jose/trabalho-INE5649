# Carregar o pacote
library(readxl)
library(forecast)
library(zoo)
# Importar o arquivo Excel
dados <- read_excel("dados_sao_paulo.xlsx")
# Separar mês e ano
mes <- as.integer(sub("/.*", "", dados$Data))
ano <- as.integer(sub(".*/", "", dados$Data))
# Corrigir o século
ano <- ifelse(ano <= 26, 2000 + ano, 1900 + ano)
# Converter para yearmon
dados$Data <- as.yearmon(
sprintf("%04d-%02d", ano, mes),
format = "%Y-%m"
)
# Separar os últimos 12 meses
h <- 12
treino <- window(serie, end = time(serie)[length(serie) - h])
teste <- tail(serie, h)
# Criar série mensal (substitua Valor pela coluna desejada)
meses <- seq(min(dados$Data), max(dados$Data), by = 1/12)
serie <- ts(dados$Valor[match(meses, dados$Data)],
start = c(1946, 1), frequency = 12)
# Importar e converter datas
dados <- read_excel("dados_sao_paulo.xlsx")
coluna <- "Temperatura"
mes <- match(substr(dados$Data, 1, 3), c("jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"))
ano <- as.integer(sub(".*/", "", dados$Data))
dados$Data <- as.yearmon(sprintf("%04d-%02d", ifelse(ano <= 26, 2000 + ano, 1900 + ano), mes), "%Y-%m")
# Criar série mensal, preservando meses ausentes
datas <- seq(min(dados$Data), max(dados$Data), by = 1/12)
valores <- dados[[coluna]][match(format(datas, "%Y-%m"), format(dados$Data, "%Y-%m"))]
serie <- ts(valores, start = c(as.integer(format(min(datas), "%Y")), as.integer(format(min(datas), "%m"))), frequency = 12)
# Separar treino e teste
h <- 12
treino <- na.interp(head(serie, -h))
teste <- tail(serie, h)
# Ajustar modelos e prever
ses_m <- ses(treino, h = h)
holt_m <- holt(treino, h = h)
hwa_m <- hw(treino, seasonal = "additive", h = h)
hwm_m <- hw(treino, seasonal = "multiplicative", h = h)
ets_m <- forecast(ets(treino), h = h)
# Reunir resultados
comparacao <- cbind(Real = as.numeric(teste),
SES = as.numeric(ses_m$mean),
Holt = as.numeric(holt_m$mean),
HW_Aditivo = as.numeric(hwa_m$mean),
HW_Multiplicativo = as.numeric(hwm_m$mean),
ETS = as.numeric(ets_m$mean))
# Gráfico comparativo
matplot(1:h, comparacao, type = "l", lty = 1, lwd = 2,
col = 1:6, xlab = "Mês", ylab = "Valor",
main = "Valores reais vs. previsões")
legend("topleft", legend = colnames(comparacao),
col = 1:6, lty = 1, lwd = 2, cex = 0.7)
# Calcular EAM
EAM <- colMeans(abs(comparacao[, -1] - comparacao[, 1]), na.rm = TRUE)
sort(EAM)
# Melhor modelo
names(which.min(EAM))
# Ajustar modelo SARIMA
modelo_sarima <- auto.arima(treino, seasonal = TRUE)
summary(modelo_sarima)
# Prever os 12 meses
previsao_sarima <- forecast(modelo_sarima, h = 12)
# Gráfico: valores reais vs. previsões
plot(previsao_sarima, main = "Previsão SARIMA", xlab = "Ano", ylab = "Valor")
lines(teste, col = "red", lwd = 2)
legend("topleft", c("SARIMA", "Real"), col = c("blue", "red"), lty = 1)
# Calcular EAM
EAM_sarima <- mean(abs(as.numeric(teste) - as.numeric(previsao_sarima$mean)), na.rm = TRUE)
print(EAM_sarima)
# Analisar resíduos
checkresiduals(modelo_sarima)
arimaorder(modelo_sarima)
# Importar e converter datas
dados <- read_excel("dados_sao_paulo.xlsx")
coluna <- "Temperatura"
mes <- match(substr(dados$Data, 1, 3), c("jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"))
ano <- as.integer(sub(".*/", "", dados$Data))
dados$Data <- as.yearmon(sprintf("%04d-%02d", ifelse(ano <= 26, 2000 + ano, 1900 + ano), mes), "%Y-%m")
# Criar série mensal, preservando meses ausentes
datas <- seq(min(dados$Data), max(dados$Data), by = 1/12)
valores <- dados[[coluna]][match(format(datas, "%Y-%m"), format(dados$Data, "%Y-%m"))]
serie <- ts(valores, start = c(as.integer(format(min(datas), "%Y")), as.integer(format(min(datas), "%m"))), frequency = 12)
library(forecast)
# Treino e teste (últimos 12 meses)
h <- 12
treino <- na.interp(window(serie, end = time(serie)[length(serie) - h]))
teste <- as.numeric(tail(serie, h))
# Ajustar modelos e prever
previsoes <- cbind(
SES = ses(treino, h = h)$mean,
Holt = holt(treino, h = h)$mean,
HW_Aditivo = hw(treino, seasonal = "additive", h = h)$mean,
HW_Multiplicativo = hw(treino, seasonal = "multiplicative", h = h)$mean,
ETS = forecast(ets(treino), h = h)$mean,
SARIMA = forecast(auto.arima(treino, seasonal = TRUE), h = h)$mean
)
library(readxl)
library(zoo)
library(forecast)
# Importar e converter datas
dados <- read_excel("dados_sao_paulo.xlsx")
coluna <- "Temperatura"
mes <- match(substr(dados$Data, 1, 3), c("jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"))
ano <- as.integer(sub(".*/", "", dados$Data))
dados$Data <- as.yearmon(sprintf("%04d-%02d", ifelse(ano <= 26, 2000 + ano, 1900 + ano), mes), "%Y-%m")
# Criar série mensal, preservando meses ausentes
datas <- seq(min(dados$Data), max(dados$Data), by = 1/12)
valores <- dados[[coluna]][match(format(datas, "%Y-%m"), format(dados$Data, "%Y-%m"))]
serie <- ts(valores, start = c(as.integer(format(min(datas), "%Y")), as.integer(format(min(datas), "%m"))), frequency = 12)
library(forecast)
# Treino e teste (últimos 12 meses)
h <- 12
treino <- na.interp(window(serie, end = time(serie)[length(serie) - h]))
teste <- as.numeric(tail(serie, h))
# Ajustar modelos e prever
previsoes <- cbind(
SES = ses(treino, h = h)$mean,
Holt = holt(treino, h = h)$mean,
HW_Aditivo = hw(treino, seasonal = "additive", h = h)$mean,
HW_Multiplicativo = hw(treino, seasonal = "multiplicative", h = h)$mean,
ETS = forecast(ets(treino), h = h)$mean,
SARIMA = forecast(auto.arima(treino, seasonal = TRUE), h = h)$mean
)
# Gráfico comparativo
comparacao <- cbind(Real = teste, previsoes)
matplot(1:h, comparacao, type = "l", lty = 1, lwd = 2,
col = 1:7, xlab = "Mês", ylab = "Valor",
main = "Valores reais vs. previsões")
legend("topleft", colnames(comparacao),
col = 1:7, lty = 1, lwd = 2, cex = 0.7)
# EAM de todos os modelos (menor = melhor)
EAM <- sort(colMeans(abs(previsoes - teste), na.rm = TRUE))
print(EAM)
# Melhor modelo
names(EAM)[1]
View(dados)
